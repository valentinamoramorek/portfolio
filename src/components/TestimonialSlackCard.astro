---
import { Image } from 'astro:assets';
import annaPhoto from '../assets/content/anna-shcherbyna.jpeg';
---

<div class="testimonial-slack-card">
	<div class="notification">
		<div class="avatar-wrap">
			<div class="avatar-circle">
				<Image class="avatar" src={annaPhoto} alt="Anna Shcherbyna, Slack testimonial avatar" />
			</div>
			<div class="app-badge">
				<img src="data:image/png;base64," alt="Slack" />
			</div>
		</div>
		<div class="content">
			<div class="top-row">
				<p class="sender">Anna</p>
				<p class="timestamp">Yesterday, 4:46 PM</p>
			</div>
			<p class="message">I really enjoy reading the social posts you write 😄</p>
		</div>
	</div>
</div>

<style>
	.testimonial-slack-card {
		position: relative;
		width: 323px;
		height: 400px;
		border-radius: 28px;
		overflow: hidden;
		background: radial-gradient(120% 90% at 30% 0%, #cfe9ff 0%, #9fcdf5 45%, #6fb0e8 100%);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif;
	}

	/* soft blurred atmosphere like a photo backdrop, without depicting a real place/person */
	.testimonial-slack-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(60% 50% at 80% 90%, rgba(255, 255, 255, 0.35), transparent 60%),
			radial-gradient(50% 40% at 10% 100%, rgba(120, 90, 60, 0.15), transparent 60%);
		filter: blur(6px);
	}

	.notification {
		position: relative;
		z-index: 2;
		width: 100%;
		background: rgba(235, 245, 255, 0.55);
		backdrop-filter: blur(18px);
		-webkit-backdrop-filter: blur(18px);
		border-radius: 22px;
		padding: 18px 20px;
		display: flex;
		gap: 14px;
		box-shadow: 0 8px 24px rgba(20, 50, 80, 0.15), inset 0 0 0 0.5px rgba(255, 255, 255, 0.4);
		opacity: 0;
		animation: slideIn 0.6s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
	}

	@keyframes slideIn {
		from {
			opacity: 0;
			transform: translateY(-14px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.avatar-wrap {
		position: relative;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
	}

	.avatar-circle {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		overflow: hidden;
		background: #d8d2c8;
	}

	.avatar {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.app-badge {
		position: absolute;
		bottom: -4px;
		right: -4px;
		width: 20px;
		height: 20px;
		border-radius: 6px;
		background: #fff;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}
	.app-badge img {
		width: 14px;
		height: 14px;
		object-fit: contain;
		display: block;
	}

	.content {
		flex: 1;
		min-width: 0;
	}

	.top-row {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 6px 10px;
		margin-bottom: 4px;
	}

	.sender {
		font-weight: 700;
		font-size: 17px;
		color: #111;
		margin: 0;
	}

	.timestamp {
		font-size: 13px;
		color: rgba(20, 30, 40, 0.55);
		white-space: nowrap;
		margin: 0;
	}

	.message {
		font-size: 17px;
		line-height: 1.3;
		color: #111;
		margin: 0;
		font-weight: 400;
		opacity: 0.9;
	}
</style>
