<div
	class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-8"
	data-modal
>
	<div class="absolute inset-0 bg-foreground/70" data-modal-backdrop></div>
	<div
		class="relative bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-5 sm:p-8"
		data-modal-panel
	>
		<button
			type="button"
			class="absolute top-3 right-3 sm:top-4 sm:right-4 w-9 h-9 rounded-full bg-white shadow flex items-center justify-center text-foreground/60 hover:text-foreground transition"
			data-modal-close
			aria-label="Close"
		>
			<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4">
				<path
					d="M6 6l12 12M18 6L6 18"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				/>
			</svg>
		</button>
		<div class="flex flex-col gap-4" data-modal-body></div>
	</div>
</div>

<script>
	const modal = document.querySelector<HTMLElement>('[data-modal]');
	const body = modal?.querySelector<HTMLElement>('[data-modal-body]');
	const backdrop = modal?.querySelector<HTMLElement>('[data-modal-backdrop]');
	const closeBtn = modal?.querySelector<HTMLElement>('[data-modal-close]');

	function buildLink(url: string, linkLabel: string) {
		const link = document.createElement('a');
		link.href = url;
		link.target = '_blank';
		link.rel = 'noopener noreferrer';
		link.className = 'inline-flex items-center gap-1 font-sans font-medium text-strong-blue hover:opacity-80 transition';
		link.textContent = `${linkLabel || 'View original'} `;
		const arrow = document.createElement('span');
		arrow.setAttribute('aria-hidden', 'true');
		arrow.textContent = '↗';
		link.appendChild(arrow);
		return link;
	}

	function slugifyClient(client: string) {
		return client.trim().toLowerCase().replace(/\s+/g, '-');
	}

	function buildCaseStudyLink(client: string) {
		const link = document.createElement('a');
		link.href = `/work/${slugifyClient(client)}`;
		link.className = 'inline-flex items-center gap-1 font-sans font-medium text-strong-blue hover:opacity-80 transition';
		link.textContent = 'Explore the case study ';
		const arrow = document.createElement('span');
		arrow.setAttribute('aria-hidden', 'true');
		arrow.textContent = '→';
		link.appendChild(arrow);
		return link;
	}

	function buildTranslatedNote() {
		const note = document.createElement('p');
		note.className = 'font-sans text-xs text-foreground/40';
		note.textContent = "Originally published in Spanish · Translated with LinkedIn's native tool.";
		return note;
	}

	function openModal(card: HTMLElement) {
		if (!modal || !body) return;

		const { type, url, linkLabel, embedUrl, client, translated } = card.dataset;
		body.innerHTML = '';

		if (type === 'video' && embedUrl) {
			const iframe = document.createElement('iframe');
			iframe.src = embedUrl;
			iframe.className = 'w-full aspect-[9/16] max-h-[70vh] rounded-xl mx-auto';
			iframe.allow = 'autoplay; encrypted-media; fullscreen';
			iframe.allowFullscreen = true;
			iframe.loading = 'lazy';
			body.appendChild(iframe);
		} else {
			const cardImg = card.querySelector('img');
			if (cardImg) {
				const img = document.createElement('img');
				img.src = cardImg.currentSrc || cardImg.src;
				img.alt = cardImg.alt;
				img.className = 'w-full h-auto rounded-xl';
				body.appendChild(img);
			}
		}

		const actions = document.createElement('div');
		actions.className = 'flex flex-wrap items-center gap-3';
		actions.appendChild(buildLink(url ?? '#', linkLabel ?? 'View original'));
		if (client) actions.appendChild(buildCaseStudyLink(client));
		body.appendChild(actions);

		if (translated === 'true') body.appendChild(buildTranslatedNote());

		modal.classList.remove('hidden');
		modal.classList.add('flex');
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!modal || !body) return;
		modal.classList.add('hidden');
		modal.classList.remove('flex');
		body.innerHTML = '';
		document.body.style.overflow = '';
	}

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;

		if (target.closest('[data-modal-close]') || target.closest('[data-modal-backdrop]')) {
			closeModal();
			return;
		}

		if (target.closest('a')) return;

		const card = target.closest<HTMLElement>('[data-card]');
		if (card) openModal(card);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') closeModal();
	});
</script>
