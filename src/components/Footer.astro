		</div>

		<div class="flex flex-col gap-3 items-center md:items-end font-sans text-foreground/70">
			<a
				href="mailto:valentinamoramorek@gmail.com"
				class="flex items-center gap-2 hover:text-foreground transition"
			>
				<span>valentinamoramorek@gmail.com</span>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					class="w-4 h-4 shrink-0"
				>
					<rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5" />
					<path
						d="M3 6l9 7 9-7"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</a>

			<a
				href="https://www.linkedin.com/in/moravalentina/"
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-2 hover:text-foreground transition"
			>
				<span>Valentina Mora Morek</span>
				<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0">
					<path
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452z"
					/>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	[data-reveal] {
		transition:
			opacity 0.7s ease-out,
			transform 0.7s ease-out;
	}

	[data-reveal].reveal-hidden {
		opacity: 0;
		transform: translateY(2rem);
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const revealEls = document.querySelectorAll<HTMLElement>('.site-footer[data-reveal]');

	if (!reduceMotion) {
		revealEls.forEach((el) => el.classList.add('reveal-hidden'));
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.remove('reveal-hidden');
				observer.unobserve(entry.target);
			}
		},
		{ threshold: 0.2 },
	);

	revealEls.forEach((el) => observer.observe(el));
</script>
