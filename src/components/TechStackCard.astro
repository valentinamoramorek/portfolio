<style>
	.tech-stack-card {
		position: relative;
		width: 323px;
		height: 400px;
		border-radius: 28px;
		overflow: hidden;
		background: linear-gradient(150deg, #f5f9d6 0%, #edf3b3 22%, #dcefe0 45%, #cfe8f5 65%, #bfe0ff 85%, #afd6ff 100%);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
		font-family: -apple-system, sans-serif;
	}

	/* soft light glow rising from the opening, selling the "bursting out" feel */
	.glow {
		position: absolute;
		left: 50%;
		bottom: 70px;
		width: 260px;
		height: 260px;
		transform: translateX(-50%);
		background: radial-gradient(circle, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.15) 45%, transparent 70%);
		pointer-events: none;
	}

	/* faint rings, centered on the box opening */
	.rings {
		position: absolute;
		left: 161px;
		bottom: 118px;
		width: 0;
		height: 0;
	}
	.ring {
		position: absolute;
		left: 0;
		bottom: 0;
		border-radius: 50%;
		border: 1px dashed rgba(15, 127, 212, 0.13);
		transform: translate(-50%, 50%);
	}
	.ring.r1 {
		width: 190px;
		height: 190px;
	}
	.ring.r2 {
		width: 270px;
		height: 270px;
		border-color: rgba(15, 127, 212, 0.09);
	}
	.ring.r3 {
		width: 350px;
		height: 350px;
		border-color: rgba(15, 127, 212, 0.06);
	}

	.icon {
		--r: 0deg;
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 13px;
		box-shadow: 0 6px 14px rgba(20, 40, 60, 0.24);
		transform: translate(-50%, -50%) rotate(var(--r));
		animation: bob 4.6s ease-in-out infinite;
	}
	.icon svg {
		display: block;
	}
	.icon img {
		width: 100%;
		height: 100%;
		border-radius: 13px;
		object-fit: cover;
		display: block;
	}

	.icon.t1 {
		width: 50px;
		height: 50px;
	}
	.icon.t2 {
		width: 44px;
		height: 44px;
	}
	.icon.t3 {
		width: 38px;
		height: 38px;
		border-radius: 11px;
	}
	.icon.t1 svg,
	.icon.t1 img {
		width: 26px;
		height: 26px;
	}
	.icon.t2 svg,
	.icon.t2 img {
		width: 22px;
		height: 22px;
	}
	.icon.t3 svg,
	.icon.t3 img {
		width: 19px;
		height: 19px;
	}

	/* logos meant to fill the whole badge (no colored background showing) */
	.icon.full-image svg,
	.icon.full-image img {
		width: 100%;
		height: 100%;
	}

	@keyframes bob {
		0%,
		100% {
			transform: translate(-50%, -50%) rotate(var(--r)) translateY(0);
		}
		50% {
			transform: translate(-50%, -50%) rotate(var(--r)) translateY(-6px);
		}
	}

	.title {
		position: absolute;
		left: 50%;
		bottom: 60px;
		transform: translateX(-50%);
		font-size: 16px;
		font-weight: 700;
		color: #fff;
		letter-spacing: -0.1px;
		text-shadow: 0 2px 6px rgba(5, 30, 60, 0.35);
		z-index: 5;
		white-space: nowrap;
	}

	/* the open box — simple flat trapezoid */
	.box {
		position: absolute;
		left: 50%;
		bottom: 26px;
		transform: translateX(-50%);
		width: 214px;
		height: 90px;
		background: linear-gradient(160deg, #8fcbfa, #3e93e3);
		clip-path: polygon(6% 0%, 94% 0%, 80% 100%, 20% 100%);
		box-shadow: 0 12px 26px rgba(15, 127, 212, 0.35);
	}
</style>
