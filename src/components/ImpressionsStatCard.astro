<div class="impressions-stat-card">
	<div class="scroll-window">
		<div class="scroll-track">
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
			<div class="stat-line">2.4M</div>
		</div>
	</div>

	<div class="message">
		<p>impressions across the Remotivate ecosystem during a 7-month period.</p>
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0f7fd4" stroke-width="2.4">
			<circle cx="10.5" cy="10.5" r="6.5" />
			<line x1="15.5" y1="15.5" x2="21" y2="21" />
		</svg>
	</div>
</div>

<style>
	.impressions-stat-card {
		position: relative;
		width: 323px;
		height: 400px;
		background: #e4f3ff;
		border-radius: 28px;
		overflow: hidden;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		font-family: 'DM Sans', sans-serif;
	}

	.scroll-window {
		position: absolute;
		inset: 0;
		overflow: hidden;
		/* fade mask: middle band full opacity, top/bottom bands 30% dimmer */
		-webkit-mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.7) 0%,
			rgba(0, 0, 0, 0.7) 28%,
			rgba(0, 0, 0, 1) 42%,
			rgba(0, 0, 0, 1) 58%,
			rgba(0, 0, 0, 0.7) 72%,
			rgba(0, 0, 0, 0.7) 100%
		);
		mask-image: linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0.7) 0%,
			rgba(0, 0, 0, 0.7) 28%,
			rgba(0, 0, 0, 1) 42%,
			rgba(0, 0, 0, 1) 58%,
			rgba(0, 0, 0, 0.7) 72%,
			rgba(0, 0, 0, 0.7) 100%
		);
	}

	.scroll-track {
		position: absolute;
		left: 50%;
		top: 0;
		transform: translateX(-50%);
		animation: scrollLoop 4.5s linear infinite;
	}

	.stat-line {
		font-family: 'DM Sans', sans-serif;
		font-weight: 800;
		font-size: 118px;
		line-height: 118px;
		color: #0f7fd4;
		text-align: center;
		letter-spacing: -2px;
		white-space: nowrap;
		padding: 6px 0;
	}

	/* 8 identical repeats = seamless loop when translated by exactly one item height */
	@keyframes scrollLoop {
		from {
			transform: translate(-50%, -130px);
		}
		to {
			transform: translate(-50%, -260px);
		}
	}

	.message {
		position: absolute;
		left: 20px;
		right: 20px;
		top: 50%;
		transform: translateY(-50%);
		background: #fff;
		border-radius: 16px;
		padding: 16px 18px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		box-shadow: 0 6px 18px rgba(15, 127, 212, 0.18);
	}

	.message p {
		margin: 0;
		font-size: 15.5px;
		font-weight: 500;
		color: #0f7fd4;
		line-height: 1.35;
	}

	.message svg {
		flex-shrink: 0;
		opacity: 0.55;
	}
</style>
