---
import { loadContentItems } from '../data/content';

const { items } = loadContentItems();
const contentTypes = [...new Set(items.map((item) => item.contentType))].sort();

const FILTER_LABELS: Record<string, string> = {
	'LinkedIn post': 'Posts',
};
---

<div class="content-filters">
	<p class="font-sans text-xs sm:text-sm uppercase tracking-wide text-foreground/40 mb-3">Filters</p>
	<div class="flex flex-wrap gap-3" data-filter-bar>
		<button
			type="button"
			class="filter-pill active font-sans text-sm sm:text-base font-medium px-5 py-2.5 rounded-xl bg-soft-blue text-strong-blue transition"
			data-filter-type="all"
		>
			All Content Type
		</button>
		{
			contentTypes.map((type) => (
				<button
					type="button"
					class="filter-pill font-sans text-sm sm:text-base px-5 py-2.5 rounded-xl bg-white border border-strong-blue/15 text-foreground/60 transition hover:border-strong-blue/40"
					data-filter-type={type}
				>
					{FILTER_LABELS[type] ?? type}
				</button>
			))
		}
	</div>
</div>

<div
	class="fixed bottom-6 right-6 z-50 rounded-full bg-foreground text-background font-sans text-sm px-4 py-2 shadow-lg opacity-0 pointer-events-none transition-opacity duration-300"
	data-filter-toast
	role="status"
	aria-live="polite"
>
	Link copied!
</div>

<script>
	const ACTIVE_CLASSES = ['bg-soft-blue', 'text-strong-blue', 'font-medium'];
	const INACTIVE_CLASSES = ['bg-white', 'border', 'border-strong-blue/15', 'text-foreground/60'];
	const FILTER_PARAM = 'type';

	const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
	const pills = bar ? Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter-type]')) : [];
	const toast = document.querySelector<HTMLElement>('[data-filter-toast]');

	function setActive(pill: HTMLButtonElement) {
		pills.forEach((p) => {
			const isActive = p === pill;
			p.classList.toggle('active', isActive);
			p.classList.remove(...ACTIVE_CLASSES, ...INACTIVE_CLASSES);
			p.classList.add(...(isActive ? ACTIVE_CLASSES : INACTIVE_CLASSES));
		});
	}

	function applyFilter(type: string) {
		const cards = document.querySelectorAll<HTMLElement>('[data-content-grid] [data-card]');
		cards.forEach((card) => {
			const show = type === 'all' || card.dataset.contentType === type;
			card.classList.toggle('hidden', !show);
		});
	}

	function updateUrl(type: string) {
		const url = new URL(window.location.href);
		if (type === 'all') {
			url.searchParams.delete(FILTER_PARAM);
		} else {
			url.searchParams.set(FILTER_PARAM, type);
		}
		window.history.replaceState({}, '', url);
		return url;
	}

	let toastTimeout: ReturnType<typeof setTimeout> | undefined;
	function showToast() {
		if (!toast) return;
		clearTimeout(toastTimeout);
		toast.classList.remove('opacity-0', 'pointer-events-none');
		toast.classList.add('opacity-100');
		toastTimeout = setTimeout(() => {
			toast.classList.add('opacity-0', 'pointer-events-none');
			toast.classList.remove('opacity-100');
		}, 1800);
	}

	async function copyLink(url: URL) {
		try {
			await navigator.clipboard.writeText(url.toString());
			showToast();
		} catch {
			// Clipboard API unavailable (e.g. insecure context) — URL is still updated for manual copy.
		}
	}

	pills.forEach((pill) => {
		pill.addEventListener('click', () => {
			const type = pill.dataset.filterType ?? 'all';
			setActive(pill);
			applyFilter(type);
			copyLink(updateUrl(type));
		});
	});

	// Deep-link support: pre-select the filter named in the URL, e.g. /portfolio?type=Short%20Video
	const initialType = new URL(window.location.href).searchParams.get(FILTER_PARAM);
	const initialPill = initialType ? pills.find((p) => p.dataset.filterType === initialType) : undefined;
	if (initialPill) {
		setActive(initialPill);
		applyFilter(initialType!);
	}
</script>
