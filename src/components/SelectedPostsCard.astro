---

<div class="selected-posts-card">
	<div class="stack" data-stack></div>
</div>

<style>
	.selected-posts-card {
		position: relative;
		width: 323px;
		height: 400px;
		background: #edf3b3;
		border-radius: 28px;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		overflow: hidden;
	}

	.stack {
		position: absolute;
		inset: 0;
	}

	.stack :global(.item) {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 196px;
		height: 246px;
		margin-top: -123px;
		margin-left: -98px;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 14px 26px rgba(0, 0, 0, 0.22);
		background: #fff;
		transition: transform 0.6s cubic-bezier(0.22, 0.9, 0.32, 1), opacity 0.6s ease;
	}

	.stack :global(.item img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
</style>

<script>
	// Scoped to each .selected-posts-card instance (Astro dedupes this script
	// to run once per page even though the carousel renders the card twice).
	document.querySelectorAll<HTMLElement>('.selected-posts-card').forEach((card) => {
		const images = [
			'',
			'',
			'',
			'',
			'',
		];

		const stack = card.querySelector<HTMLElement>('[data-stack]')!;
		const items = images.map((src) => {
			const el = document.createElement('div');
			el.className = 'item';
			const img = document.createElement('img');
			img.src = 'data:image/jpeg;base64,' + src;
			el.appendChild(img);
			stack.appendChild(el);
			return el;
		});

		const n = items.length;
		let current = 0;

		// diff -> { translateX, scale, rotate, opacity, z }
		const positions: Record<number, { x: number; s: number; r: number; o: number; z: number }> = {
			0: { x: 0, s: 1, r: 0, o: 1, z: 5 },
			1: { x: 78, s: 0.84, r: 7, o: 0.55, z: 3 },
			[-1]: { x: -78, s: 0.84, r: -7, o: 0.55, z: 3 },
			2: { x: 140, s: 0.68, r: 12, o: 0, z: 1 },
			[-2]: { x: -140, s: 0.68, r: -12, o: 0, z: 1 },
		};

		function render() {
			items.forEach((el, i) => {
				let diff = (i - current) % n;
				if (diff > 2) diff -= n;
				if (diff < -2) diff += n;
				const p = positions[diff] || positions[diff > 0 ? 2 : -2];
				el.style.transform = `translate(${p.x}px, 0) scale(${p.s}) rotate(${p.r}deg)`;
				el.style.opacity = String(p.o);
				el.style.zIndex = String(p.z);
			});
		}

		render();
		setInterval(() => {
			current = (current + 1) % n;
			render();
		}, 2200);
	});
</script>
