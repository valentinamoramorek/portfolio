---
import SelectedPostsCard from './SelectedPostsCard.astro';
import ImpressionsStatCard from './ImpressionsStatCard.astro';
import TechStackCard from './TechStackCard.astro';
import TestimonialSlackCard from './TestimonialSlackCard.astro';
import NewFollowersCard from './NewFollowersCard.astro';
import SkillsBadgesCard from './SkillsBadgesCard.astro';
---

<section class="carousel py-12 md:py-16 overflow-hidden">
	<div class="flex w-max gap-5 md:gap-6 track">
		<!--
			Rendered twice back-to-back so translateX(-50%) always lands on an
			identical frame, making the scroll loop seamlessly without any
			JS-driven reset.
		-->
		<div class="shrink-0"><SelectedPostsCard /></div>
		<div class="shrink-0"><ImpressionsStatCard /></div>
		<div class="shrink-0"><TechStackCard /></div>
		<div class="shrink-0"><TestimonialSlackCard /></div>
		<div class="shrink-0"><NewFollowersCard /></div>
		<div class="shrink-0"><SkillsBadgesCard /></div>

		<div class="shrink-0"><SelectedPostsCard /></div>
		<div class="shrink-0"><ImpressionsStatCard /></div>
		<div class="shrink-0"><TechStackCard /></div>
		<div class="shrink-0"><TestimonialSlackCard /></div>
		<div class="shrink-0"><NewFollowersCard /></div>
		<div class="shrink-0"><SkillsBadgesCard /></div>
	</div>
</section>

<style>
	.track {
		animation: marquee 30s linear infinite;
	}

	.carousel:hover .track {
		animation-play-state: paused;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
		}
	}
</style>
