---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WorkCarousel from '../components/WorkCarousel.astro';
import WorkCards from '../components/WorkCards.astro';
import About from '../components/About.astro';
import CaptionedCarousel from '../components/CaptionedCarousel.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ConnectCTA from '../components/ConnectCTA.astro';
import Footer from '../components/Footer.astro';
import { caseStudies } from '../data/caseStudies';

const clientNames = caseStudies.map((caseStudy) => caseStudy.client);
const clientList = `${clientNames.slice(0, -1).join(', ')}, and ${clientNames[clientNames.length - 1]}`;

const title = 'B2B Content Manager - Valentina Mora';
const description = `B2B Content Manager helping brands like ${clientList} go from seen to chosen through content strategy, social media management, and brand storytelling.`;

const siteUrl = (Astro.site?.toString() ?? 'https://valentinamoramorek.com/').replace(/\/$/, '');

const personJsonLd = {
	'@type': 'Person',
	name: 'Valentina Mora',
	jobTitle: 'B2B Content Manager',
	url: siteUrl,
	sameAs: ['https://www.linkedin.com/in/moravalentina/'],
};
---

<Layout title={title} description={description} jsonLd={personJsonLd}>
	<Hero />
	<WorkCarousel />
	<WorkCards />
	<About />
	<CaptionedCarousel />
	<ServicesSection />
	<ConnectCTA />
	<Footer />
</Layout>
