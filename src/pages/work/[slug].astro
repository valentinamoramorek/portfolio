---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ContentGrid from '../../components/ContentGrid.astro';
import ContentModal from '../../components/ContentModal.astro';
import { caseStudies, getNextCaseStudy } from '../../data/caseStudies';
import { parseBoldSegments } from '../../utils/text';
import starIcon from '../../icons/star.png';

export function getStaticPaths() {
	return caseStudies.map((caseStudy) => ({
		params: { slug: caseStudy.slug },
		props: { caseStudy },
	}));
}

const { caseStudy } = Astro.props;

const caseStudyImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/case-studies/*.{png,jpg,jpeg,webp,gif}',
	{ eager: true },
);

const challengeImage = caseStudy.challenge ? (caseStudyImages[caseStudy.challenge.image]?.default ?? null) : null;
const strategyImage = caseStudy.strategy ? (caseStudyImages[caseStudy.strategy.image]?.default ?? null) : null;

const pageTitle = `${caseStudy.client} Content Strategy — Valentina Mora`;

const leadMetric = caseStudy.results?.[0];
const pageDescription = leadMetric
	? `${caseStudy.client} case study: ${caseStudy.title}, resulting in ${leadMetric.value} ${leadMetric.label.toLowerCase()}.`
	: `${caseStudy.client} case study: ${caseStudy.title}.`;

const siteUrl = (Astro.site?.toString() ?? 'https://valentinamoramorek.com/').replace(/\/$/, '');
const canonicalUrl = `${siteUrl}/work/${caseStudy.slug}`;
const ogImage = `${siteUrl}${caseStudy.nextImage}`;

const creativeWorkJsonLd = {
	'@type': 'CreativeWork',
	name: caseStudy.title,
	url: canonicalUrl,
	about: { '@type': 'Organization', name: caseStudy.client },
	publisher: { '@type': 'Organization', name: caseStudy.client },
	author: {
		'@type': 'Person',
		name: 'Valentina Mora',
		url: siteUrl,
	},
};

function chunk<T>(items: T[], size: number): T[][] {
	const rows: T[][] = [];
	for (let i = 0; i < items.length; i += size) rows.push(items.slice(i, i + size));
	return rows;
}

const resultRows = caseStudy.results ? chunk(caseStudy.results, 3) : [];

const nextCaseStudy = getNextCaseStudy(caseStudy.slug);
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonical={canonicalUrl}
	image={ogImage}
	type="article"
	jsonLd={creativeWorkJsonLd}
>
	<section class="px-6 pt-6 pb-12 md:pb-16">
		<div class="max-w-6xl mx-auto">
			<h1
				class="font-heading font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-tight text-foreground text-balance"
			>
				{caseStudy.title}
			</h1>
			<p class="font-sans text-base sm:text-lg text-foreground/70 mt-4 max-w-3xl">
				{caseStudy.intro}
			</p>

			<div class="mt-10 md:mt-12 flex flex-wrap gap-x-12 gap-y-6">
				<div>
					<p class="font-sans text-xs sm:text-sm uppercase tracking-wide text-foreground/40 mb-3">Role</p>
					<span
						class="inline-block font-sans text-sm sm:text-base bg-[#E4F3FF] text-strong-blue rounded-[4px] px-4 py-2 transition-colors duration-200 ease-out hover:bg-[#CFEAFF]"
					>
						{caseStudy.role}
					</span>
				</div>

				<div>
					<p class="font-sans text-xs sm:text-sm uppercase tracking-wide text-foreground/40 mb-3">Timeline</p>
					<span
						class="inline-block font-sans text-sm sm:text-base bg-[#E4F3FF] text-strong-blue rounded-[4px] px-4 py-2 transition-colors duration-200 ease-out hover:bg-[#CFEAFF]"
					>
						{caseStudy.timeline}
					</span>
				</div>

				<div>
					<p class="font-sans text-xs sm:text-sm uppercase tracking-wide text-foreground/40 mb-3">Tech Stack</p>
					<div class="flex flex-wrap gap-2">
						{
							caseStudy.techStack.map((tech) => (
								<span class="inline-block font-sans text-sm sm:text-base bg-[#E4F3FF] text-strong-blue rounded-[4px] px-4 py-2 transition-colors duration-200 ease-out hover:bg-[#CFEAFF]">
									{tech}
								</span>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="border-t border-dashed border-strong-blue"></div>

	{
		caseStudy.challenge && (
			<section class="case-study-section px-6 py-12 md:py-16" data-reveal>
				<div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-14 items-center">
					<div>
						<h2 class="font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-foreground">
							The Challenge
						</h2>
						<div class="mt-6 flex flex-col gap-4">
							{caseStudy.challenge.paragraphs.map((paragraph) => (
								<p class="font-sans text-base sm:text-lg text-foreground/70">
									{parseBoldSegments(paragraph).map((segment) =>
										segment.bold ? (
											<strong class="font-semibold text-foreground">{segment.text}</strong>
										) : (
											segment.text
										),
									)}
								</p>
							))}
						</div>
					</div>

					<div class="bg-soft-lime rounded-3xl p-6 sm:p-8 flex flex-col gap-6">
						{challengeImage && (
							<div class="overflow-hidden max-w-[422px] mx-auto">
								<Image
									src={challengeImage}
									alt={caseStudy.challenge.imageLabel ? `${caseStudy.client} — ${caseStudy.challenge.imageLabel}` : caseStudy.client}
									widths={[320, 480, 640]}
									sizes="(min-width: 768px) 40vw, 100vw"
									format="webp"
									quality={80}
									loading="lazy"
									class="w-full h-auto grayscale-[15%] transition duration-200 ease-out hover:scale-[1.03] hover:grayscale-0"
								/>
							</div>
						)}
						{caseStudy.challenge.imageLabel && (
							<p class="font-sans text-xl sm:text-2xl text-foreground">{caseStudy.challenge.imageLabel}</p>
						)}
					</div>
				</div>
			</section>
		)
	}

	{
		caseStudy.strategy && (
			<section class="case-study-section px-6 py-12 md:py-16" data-reveal>
				<div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-10 md:gap-14 items-center">
					<div>
						<h2 class="font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-foreground">
							The Strategy
						</h2>
						<div class="mt-6 flex flex-col gap-4">
							{caseStudy.strategy.paragraphs.map((paragraph) => (
								<p class="font-sans text-base sm:text-lg text-foreground/70">
									{parseBoldSegments(paragraph).map((segment) =>
										segment.bold ? (
											<strong class="font-semibold text-foreground">{segment.text}</strong>
										) : (
											segment.text
										),
									)}
								</p>
							))}
						</div>
					</div>

					<div class="bg-bright-lime rounded-3xl p-6 sm:p-8 flex flex-col gap-6 md:order-first">
						{strategyImage && (
							<div class="overflow-hidden">
								<Image
									src={strategyImage}
									alt={caseStudy.strategy.imageLabel ? `${caseStudy.client} — ${caseStudy.strategy.imageLabel}` : caseStudy.client}
									widths={[320, 480, 640]}
									sizes="(min-width: 768px) 40vw, 100vw"
									format="webp"
									quality={80}
									loading="lazy"
									class="w-full h-auto grayscale-[15%] transition duration-200 ease-out hover:scale-[1.03] hover:grayscale-0"
								/>
							</div>
						)}
						{caseStudy.strategy.imageLabel && (
							<p class="font-sans text-xl sm:text-2xl text-foreground">{caseStudy.strategy.imageLabel}</p>
						)}
					</div>
				</div>
			</section>
		)
	}

	{
		caseStudy.channels && (
			<section class="case-study-section px-6 py-12 md:py-16" data-reveal>
				<div class="max-w-6xl mx-auto bg-soft-blue rounded-3xl p-6 sm:p-10 md:p-12">
					<h2 class="font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-foreground">
						The Channels
					</h2>

					<div class="mt-8 md:mt-10 flex flex-wrap justify-center gap-x-10 gap-y-10">
						{caseStudy.channels.map((channel) => (
							<div class="group flex flex-col items-center text-center gap-3 transition duration-200 ease-out hover:-translate-y-1">
								<Icon
									name={`${channel.platform}_logo`}
									class="h-12 w-auto transition-transform duration-200 ease-out group-hover:scale-105"
								/>
								<p class="font-heading font-bold text-lg sm:text-xl text-foreground">{channel.name}</p>
								<div class="flex flex-col items-center gap-2">
									{channel.companyPage && (
										<span class="inline-block font-sans text-sm sm:text-base bg-[#E4F3FF] text-strong-blue rounded-[4px] px-4 py-2">
											Company Page
										</span>
									)}
									{channel.personalBrand && (
										<span class="inline-block font-sans text-sm sm:text-base bg-[#E4F3FF] text-strong-blue rounded-[4px] px-4 py-2">
											Personal Brand
										</span>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	{
		caseStudy.results && (
			<section class="case-study-section px-6 pt-12 md:pt-16" data-reveal>
				<div class="max-w-6xl mx-auto text-center">
					<h2 class="font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-foreground">
						The Results
					</h2>

					<div class="mt-10 md:mt-14 flex flex-col items-center gap-8 md:gap-14">
						{resultRows.map((row) => (
							<div class="contents md:flex md:flex-wrap md:justify-center md:gap-[155px]">
								{row.map((result) => (
									<div class="flex flex-col items-center text-center md:items-start md:text-left w-auto">
										<Image src={starIcon} alt="" width={56} height={56} loading="lazy" class="w-14 h-14 rounded-xl" />
										<p
											class="mt-[35px] font-sans font-medium text-5xl sm:text-6xl text-foreground tabular-nums"
											data-count-value={result.value}
										>
											{result.value}
										</p>
										<p class="mt-3 font-sans text-lg text-foreground/60 whitespace-nowrap">{result.label}</p>
									</div>
								))}
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section class="case-study-section bg-soft-lime px-6 pb-12 md:pb-16 mt-[120px]" data-reveal>
		<div class="max-w-6xl mx-auto pt-12 md:pt-16">
			<h2 class="font-heading font-bold text-3xl sm:text-4xl md:text-5xl leading-tight text-foreground mb-8 md:mb-10">
				Featured Content
			</h2>

			<ContentGrid client={caseStudy.featuredClients ?? caseStudy.client} />

			<div class="mt-10 md:mt-12 flex justify-center">
				<a
					href="/portfolio"
					class="inline-block bg-strong-blue text-white font-sans font-bold text-sm sm:text-base px-8 py-3.5 rounded-2xl transition duration-200 ease-out hover:brightness-95 hover:-translate-y-0.5"
				>
					See More
				</a>
			</div>
		</div>
	</section>

	<section class="case-study-section px-6 py-12 md:py-16" data-reveal>
		<div class="max-w-6xl mx-auto">
			<a
				href={`/work/${nextCaseStudy.slug}`}
				class="group flex items-center gap-6 md:gap-10 bg-soft-blue rounded-3xl p-6 sm:p-8 md:p-10 transition duration-200 ease-out hover:brightness-95"
			>
				<img
					src={nextCaseStudy.nextImage}
					alt={nextCaseStudy.client}
					class="shrink-0 w-20 sm:w-28 md:w-32 h-auto"
					loading="lazy"
				/>

				<div class="flex-1 min-w-0">
					<p class="font-sans text-xs sm:text-sm uppercase tracking-wide text-foreground/50 mb-2">
						Next case study
					</p>
					<span class="inline-block font-sans text-xs sm:text-sm bg-white/70 text-strong-blue rounded-full px-4 py-1 mb-3">
						{nextCaseStudy.client}
					</span>
					<h3 class="font-heading font-bold text-xl sm:text-2xl md:text-3xl leading-tight text-foreground text-balance">
						{nextCaseStudy.title}
					</h3>
				</div>

				<div class="shrink-0 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-bright-lime flex items-center justify-center transition duration-200 ease-out group-hover:translate-x-1">
					<svg viewBox="0 0 24 24" fill="none" class="w-5 h-5 sm:w-6 sm:h-6" aria-hidden="true">
						<path
							d="M9 6l6 6-6 6"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</div>
			</a>
		</div>
	</section>

	<ContentModal />

	<Footer />
</Layout>

<style>
	[data-reveal] {
		transition:
			opacity 0.7s ease-out,
			transform 0.7s ease-out;
	}

	[data-reveal].reveal-hidden {
		opacity: 0;
		transform: translateY(2rem);
	}
</style>

<script>
	interface ParsedCount {
		target: number;
		decimals: number;
		grouped: boolean;
		suffix: string;
	}

	function parseCountValue(raw: string): ParsedCount | null {
		const match = raw.match(/^([\d,]*\.?\d+)(.*)$/);
		if (!match) return null;

		const [, numPart, suffix] = match;
		const grouped = numPart.includes(',');
		const cleaned = numPart.replace(/,/g, '');
		const decimals = cleaned.includes('.') ? cleaned.split('.')[1].length : 0;

		return { target: parseFloat(cleaned), decimals, grouped, suffix };
	}

	function formatCountValue({ decimals, grouped, suffix }: ParsedCount, current: number): string {
		let numStr = current.toFixed(decimals);

		if (grouped) {
			const [intPart, decPart] = numStr.split('.');
			numStr = Number(intPart).toLocaleString('en-US') + (decPart ? `.${decPart}` : '');
		}

		return `${numStr}${suffix}`;
	}

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const revealEls = document.querySelectorAll<HTMLElement>('.case-study-section[data-reveal]');
	const countEls = document.querySelectorAll<HTMLElement>('[data-count-value]');

	if (!reduceMotion) {
		revealEls.forEach((el) => el.classList.add('reveal-hidden'));
	}

	function animateCount(el: HTMLElement) {
		const parsed = parseCountValue(el.dataset.countValue ?? '');
		if (!parsed) return;

		if (reduceMotion) {
			el.textContent = formatCountValue(parsed, parsed.target);
			return;
		}

		const duration = 1800;
		const start = performance.now();

		function easeInOutCubic(t: number): number {
			return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
		}

		function tick(now: number) {
			if (!parsed) return;
			const progress = Math.min((now - start) / duration, 1);
			const eased = easeInOutCubic(progress);
			el.textContent = formatCountValue(parsed, parsed.target * eased);
			if (progress < 1) requestAnimationFrame(tick);
		}

		requestAnimationFrame(tick);
	}

	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				const el = entry.target as HTMLElement;

				if (el.hasAttribute('data-reveal')) {
					el.classList.remove('reveal-hidden');
				}
				if (el.hasAttribute('data-count-value')) {
					animateCount(el);
				}

				observer.unobserve(el);
			}
		},
		{ threshold: 0.15 },
	);

	revealEls.forEach((el) => observer.observe(el));
	countEls.forEach((el) => observer.observe(el));
</script>
